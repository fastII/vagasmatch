# Copie para .env (na raiz do repositório). O .env está no .gitignore e nunca vai para o git.
# Use UMA das chaves (ou as duas e escolha com VAGAMATCH_PROVIDER).
OPENAI_API_KEY=
#ANTHROPIC_API_KEY=

# Opcionais
#VAGAMATCH_PROVIDER=openai      # openai | anthropic (força o provedor)
#VAGAMATCH_MODEL=gpt-5          # padrão: gpt-5 (OpenAI) ou claude-opus-5-5 (Anthropic)
#VAGAMATCH_EFFORT=medium        # low | medium | high
#PORT=3000
